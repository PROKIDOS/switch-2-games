<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<title>Strzelanka 3D - Switch</title>
<style>
  body { margin: 0; overflow: hidden; background: #000; font-family: sans-serif; }
  #hud {
    position: absolute; top: 10px; left: 10px; color: #0f0;
    font-size: 16px; text-shadow: 1px 1px 2px #000; z-index: 10;
  }
  #crosshair {
    position: absolute; top: 50%; left: 50%;
    width: 20px; height: 20px; margin: -10px 0 0 -10px;
    border: 2px solid #0f0; border-radius: 50%; pointer-events: none;
  }
  #info {
    position: absolute; bottom: 10px; left: 10px; color: #aaa;
    font-size: 13px; z-index: 10;
  }
</style>
</head>
<body>
<div id="hud">Wynik: <span id="score">0</span></div>
<div id="crosshair"></div>
<div id="info">Lewy drążek: ruch | Prawy drążek / D-Pad: rozglądanie | A: strzał</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
// --- Scena ---
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x111122);
scene.fog = new THREE.Fog(0x111122, 20, 60);

const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 200);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
document.body.appendChild(renderer.domElement);

// Oświetlenie
scene.add(new THREE.AmbientLight(0x888888));
const dir = new THREE.DirectionalLight(0xffffff, 1);
dir.position.set(10, 20, 10);
scene.add(dir);

// Podłoga (siatka)
const floor = new THREE.Mesh(
  new THREE.PlaneGeometry(100, 100),
  new THREE.MeshStandardMaterial({ color: 0x224422 })
);
floor.rotation.x = -Math.PI / 2;
scene.add(floor);

const grid = new THREE.GridHelper(100, 50, 0x446644, 0x223322);
grid.position.y = 0.01;
scene.add(grid);

// Gracz
const player = {
  pos: new THREE.Vector3(0, 1.6, 0),
  yaw: 0,
  pitch: 0,
  speed: 8,
  score: 0
};

// Wrogowie
const enemies = [];
function spawnEnemy() {
  const geo = new THREE.BoxGeometry(1, 1.5, 1);
  const mat = new THREE.MeshStandardMaterial({ color: 0xff3333 });
  const mesh = new THREE.Mesh(geo, mat);
  const angle = Math.random() * Math.PI * 2;
  const dist = 20 + Math.random() * 15;
  mesh.position.set(Math.cos(angle)*dist, 0.75, Math.sin(angle)*dist);
  scene.add(mesh);
  enemies.push({ mesh, hp: 2 });
}
for (let i = 0; i < 6; i++) spawnEnemy();

// Pociski
const bullets = [];
function shoot() {
  const geo = new THREE.SphereGeometry(0.15, 8, 8);
  const mat = new THREE.MeshBasicMaterial({ color: 0x00ffff });
  const b = new THREE.Mesh(geo, mat);
  b.position.copy(player.pos);
  const dirV = new THREE.Vector3(0, 0, -1);
  dirV.applyEuler(new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ'));
  b.userData.vel = dirV.multiplyScalar(40);
  scene.add(b);
  bullets.push(b);
}

// --- Obsługa pada ---
let gamepadIndex = null;
let prevA = false;

addEventListener('gamepadconnected', e => {
  gamepadIndex = e.gamepad.index;
  console.log('Pad podłączony:', e.gamepad.id);
});
addEventListener('gamepaddisconnected', () => { gamepadIndex = null; });

function pollGamepad(dt) {
  if (gamepadIndex === null) return;
  const gp = navigator.getGamepads()[gamepadIndex];
  if (!gp) return;

  const deadzone = 0.15;
  // Lewy drążek - ruch
  let lx = gp.axes[0] || 0;
  let ly = gp.axes[1] || 0;
  if (Math.abs(lx) < deadzone) lx = 0;
  if (Math.abs(ly) < deadzone) ly = 0;

  // Ruch względem patrzenia
  const forward = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(0, player.yaw, 0));
  const right = new THREE.Vector3(1, 0, 0).applyEuler(new THREE.Euler(0, player.yaw, 0));
  player.pos.addScaledVector(forward, -ly * player.speed * dt);
  player.pos.addScaledVector(right, lx * player.speed * dt);

  // Prawy drążek - rozglądanie
  let rx = gp.axes[2] || 0;
  let ry = gp.axes[3] || 0;
  if (Math.abs(rx) < deadzone) rx = 0;
  if (Math.abs(ry) < deadzone) ry = 0;
  player.yaw -= rx * 2.5 * dt;
  player.pitch -= ry * 2.0 * dt;
  player.pitch = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, player.pitch));

  // D-Pad (przyciski 12-15)
  const dpadSpeed = 2.0 * dt;
  if (gp.buttons[14]?.pressed) player.yaw += dpadSpeed;
  if (gp.buttons[15]?.pressed) player.yaw -= dpadSpeed;
  if (gp.buttons[12]?.pressed) player.pitch += dpadSpeed;
  if (gp.buttons[13]?.pressed) player.pitch -= dpadSpeed;

  // Przycisk A (index 0) - strzał
  const aPressed = gp.buttons[0]?.pressed;
  if (aPressed && !prevA) shoot();
  prevA = aPressed;
}

// --- Klawiatura (fallback) ---
const keys = {};
addEventListener('keydown', e => { keys[e.code] = true; if (e.code === 'Space') shoot(); });
addEventListener('keyup', e => { keys[e.code] = false; });

function pollKeyboard(dt) {
  let lx = 0, ly = 0;
  if (keys['KeyW']) ly -= 1;
  if (keys['KeyS']) ly += 1;
  if (keys['KeyA']) lx -= 1;
  if (keys['KeyD']) lx += 1;
  const forward = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(0, player.yaw, 0));
  const right = new THREE.Vector3(1, 0, 0).applyEuler(new THREE.Euler(0, player.yaw, 0));
  player.pos.addScaledVector(forward, -ly * player.speed * dt);
  player.pos.addScaledVector(right, lx * player.speed * dt);

  if (keys['ArrowLeft']) player.yaw += 2 * dt;
  if (keys['ArrowRight']) player.yaw -= 2 * dt;
  if (keys['ArrowUp']) player.pitch += 1.5 * dt;
  if (keys['ArrowDown']) player.pitch -= 1.5 * dt;
}

// --- Pętla gry ---
const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.1);

  pollGamepad(dt);
  pollKeyboard(dt);

  // Kamera
  camera.position.copy(player.pos);
  camera.rotation.order = 'YXZ';
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;

  // Pociski
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.position.addScaledVector(b.userData.vel, dt);
    if (b.position.length() > 100) {
      scene.remove(b);
      bullets.splice(i, 1);
      continue;
    }
    // Kolizja z wrogami
    for (let j = enemies.length - 1; j >= 0; j--) {
      const e = enemies[j];
      if (b.position.distanceTo(e.mesh.position) < 1.2) {
        e.hp--;
        scene.remove(b);
        bullets.splice(i, 1);
        if (e.hp <= 0) {
          scene.remove(e.mesh);
          enemies.splice(j, 1);
          player.score++;
          document.getElementById('score').textContent = player.score;
          spawnEnemy();
        }
        break;
      }
    }
  }

  // Wrogowie powoli podchodzą
  for (const e of enemies) {
    const toPlayer = new THREE.Vector3().subVectors(player.pos, e.mesh.position);
    toPlayer.y = 0;
    const d = toPlayer.length();
    if (d > 2) {
      toPlayer.normalize();
      e.mesh.position.addScaledVector(toPlayer, 1.5 * dt);
    }
  }

  renderer.render(scene, camera);
}
animate();

// Resize
addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>